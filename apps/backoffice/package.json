{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "backoffice",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "concurrently \"php artisan serve\" \"vite\"",
        "lint": "vendor/bin/pint --test",
        "format": "vendor/bin/pint --test",
        "typecheck": "php artisan about",
        "test": "php artisan test",
        "test:cov": "php artisan test",
        "validate": "php artisan route:list --except-vendor",
        "clean": "rm -rf public/build storage/framework/cache/* storage/framework/sessions/* storage/framework/views/*"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "@sibylhub/design-system": "workspace:*",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.7"
    }
}
