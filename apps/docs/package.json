{
  "name": "docs",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "docusaurus start --port 3001",
    "build": "docusaurus build",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/validate-links.mjs",
    "format": "prettier --check docs src *.ts",
    "test": "node scripts/validate-links.mjs",
    "test:cov": "pnpm test",
    "validate": "node scripts/validate-links.mjs",
    "clean": "docusaurus clear && rm -rf build .docusaurus"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "3.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@sibylhub/typescript-config": "workspace:*",
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/plugin-content-docs": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.8",
    "typescript": "7.0.2"
  }
}
