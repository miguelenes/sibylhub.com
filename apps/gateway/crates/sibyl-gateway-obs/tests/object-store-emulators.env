# Env for the `objstore_smoke` real-backend e2e — pairs with
# object-store-emulators.compose.yml. Source it, then run the smoke tests:
#   set -a; source crates/sibyl-gateway-obs/tests/object-store-emulators.env; set +a
#   cargo test -p sibyl-gateway-obs -- --ignored objstore_smoke
#
# These are LOCAL EMULATOR credentials only (MinIO defaults, Azurite's
# well-known devstoreaccount1 key, fake-gcs disabled-oauth) — not secrets.

# ── S3 (MinIO) ──
SIBYL_GATEWAY_E2E_OBJSTORE_S3_ENDPOINT=http://127.0.0.1:9000
SIBYL_GATEWAY_E2E_OBJSTORE_S3_BUCKET=sibyl-gateway-smoke
SIBYL_GATEWAY_E2E_OBJSTORE_S3_ACCESS_KEY_ID=minioadmin
SIBYL_GATEWAY_E2E_OBJSTORE_S3_SECRET_ACCESS_KEY=minioadmin

# ── Azure Blob (Azurite) — well-known emulator account + fixed key ──
SIBYL_GATEWAY_E2E_OBJSTORE_AZURE_ENDPOINT=http://127.0.0.1:10000/devstoreaccount1
SIBYL_GATEWAY_E2E_OBJSTORE_AZURE_CONTAINER=sibyl-gateway-smoke
SIBYL_GATEWAY_E2E_OBJSTORE_AZURE_ACCOUNT=devstoreaccount1
SIBYL_GATEWAY_E2E_OBJSTORE_AZURE_ACCESS_KEY=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==

# ── GCS (fake-gcs-server) — disabled-oauth service account ──
SIBYL_GATEWAY_E2E_OBJSTORE_GCS_ENDPOINT=http://127.0.0.1:4443
SIBYL_GATEWAY_E2E_OBJSTORE_GCS_BUCKET=sibyl-gateway-smoke
# Single-quoted: the JSON has commas, which bash brace-expands (mangling it)
# if left unquoted when this file is `source`d.
SIBYL_GATEWAY_E2E_OBJSTORE_GCS_SERVICE_ACCOUNT='{"gcs_base_url":"http://127.0.0.1:4443","disable_oauth":true,"client_email":"fake@fake.iam.gserviceaccount.com","private_key_id":"","private_key":""}'
