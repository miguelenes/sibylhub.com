{
  "name": "web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 4321",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "node scripts/deploy.mjs",
    "validate": "node scripts/validate-config.mjs",
    "lint": "astro check",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "format": "prettier --plugin=prettier-plugin-astro --check src scripts *.ts",
    "clean": "rm -rf dist .astro .wrangler coverage"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.1",
    "@astrojs/react": "6.0.5",
    "@heroui/react": "3.2.5",
    "@heroui/styles": "3.2.5",
    "@sibylhub/api-client": "workspace:*",
    "@sibylhub/design-system": "workspace:*",
    "@sibylhub/schemas": "workspace:*",
    "astro": "7.3.2",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@sibylhub/typescript-config": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitest/coverage-v8": "4.1.11",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "1.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "4.1.11",
    "wrangler": "4.132.0"
  }
}
