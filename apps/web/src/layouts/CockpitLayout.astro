---
interface Props {
  title?: string;
  projectName: string;
  projectId: string;
  projectStatus: "ready" | "degraded" | "stale" | "unavailable";
  source: "local" | "d1";
  sourceRevision: string;
  activePath?: string;
}

const {
  title = "SibylHub cockpit",
  projectName,
  projectId,
  projectStatus,
  source,
  sourceRevision,
  activePath = "/",
} = Astro.props;
const navigation = [
  { href: "#observatory", label: "Observatory" },
  { href: "#memory", label: "Memory graph" },
  { href: "#dependencies", label: "Dependency audit" },
  { href: "#skills", label: "FastMCP skills" },
];
const statusLabel =
  projectStatus === "unavailable"
    ? "Unavailable"
    : projectStatus.charAt(0).toUpperCase() + projectStatus.slice(1);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="A server-first observatory for SibylHub project context and governance."
    />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <header class="border-b border-border/80 bg-background/95">
      <div class="mx-auto flex max-w-[1440px] items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-8">
        <a href="/" class="min-w-0" aria-label="SibylHub cockpit home">
          <span class="font-mono text-[0.6875rem] font-semibold uppercase tracking-[0.24em] text-primary">
            SibylHub
          </span>
          <span class="mt-1 block truncate text-sm font-semibold text-foreground">
            Context observatory
          </span>
        </a>

        <div class="flex items-center gap-2 sm:gap-3">
          <span
            class="hidden rounded-full border border-border bg-surface px-2.5 py-1 font-mono text-[0.6875rem] uppercase tracking-wide text-muted-foreground sm:inline-flex"
            data-project-status={projectStatus}
            role="status"
          >
            {source} · {statusLabel}
          </span>
          <details class="relative md:hidden">
            <summary class="cursor-pointer list-none rounded-md border border-border bg-surface px-3 py-2 text-sm font-medium text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
              Menu
            </summary>
            <nav
              aria-label="Primary navigation"
              class="absolute right-0 z-20 mt-2 grid min-w-48 gap-1 rounded-lg border border-border bg-surface p-2 shadow-xl"
            >
              {navigation.map((item) => (
                <a
                  href={item.href}
                  class:list={[
                    "rounded-md px-3 py-2 text-sm text-muted-foreground hover:bg-muted hover:text-foreground",
                    { "bg-muted text-foreground": activePath === item.href },
                  ]}
                >
                  {item.label}
                </a>
              ))}
            </nav>
          </details>
        </div>
      </div>
    </header>

    <div class="mx-auto flex max-w-[1440px] flex-col gap-6 px-4 py-6 sm:px-6 lg:flex-row lg:px-8 lg:py-8">
      <aside class="hidden w-56 shrink-0 lg:block">
        <div class="sticky top-6 space-y-4">
          <form
            action="/"
            method="get"
            class="rounded-lg border border-border bg-surface p-3"
          >
            <label
              for="project-switcher"
              class="font-mono text-[0.6875rem] uppercase tracking-[0.16em] text-muted-foreground"
            >
              Active project
            </label>
            <select
              id="project-switcher"
              name="project_id"
              class="mt-2 w-full min-w-0 rounded-md border border-border bg-background px-2.5 py-2 text-sm text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
            >
              <option value={projectId}>{projectName}</option>
            </select>
            <button
              type="submit"
              class="mt-2 w-full rounded-md bg-primary px-3 py-2 text-sm font-semibold text-primary-foreground hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
            >
              Open project
            </button>
          </form>

          <nav aria-label="Primary navigation" class="grid gap-1">
            {navigation.map((item) => (
              <a
                href={item.href}
                class:list={[
                  "rounded-md px-3 py-2 text-sm text-muted-foreground transition-colors hover:bg-surface hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring",
                  { "bg-surface text-foreground": activePath === item.href },
                ]}
              >
                {item.label}
              </a>
            ))}
          </nav>

          <div class="rounded-lg border border-border/70 bg-surface/60 p-3">
            <p class="font-mono text-[0.6875rem] uppercase tracking-[0.16em] text-muted-foreground">
              Source revision
            </p>
            <p class="mt-2 break-all font-mono text-xs text-foreground">
              {sourceRevision}
            </p>
          </div>
        </div>
      </aside>

      <main id="main-content" class="min-w-0 flex-1">
        <slot />
      </main>
    </div>
  </body>
</html>
