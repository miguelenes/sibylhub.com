{
  "name": "sibylhub-platform",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12.0 <25",
    "pnpm": ">=9.15.9 <10"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "turbo run dev --filter=web",
    "dev:backend": "turbo run dev --filter=backend",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:cov": "turbo run test:cov",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "node scripts/format.mjs --check",
    "format:write": "node scripts/format.mjs",
    "check:config": "node scripts/check-config.mjs",
    "verify:contracts": "node scripts/verify-contracts.mjs",
    "clean": "turbo run clean && rm -rf .turbo target",
    "prepare": "node scripts/check-config.mjs",
    "doctor": "npx react-doctor@latest"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "prettier-plugin-astro": "1.0.0",
    "react-doctor": "^0.9.14",
    "turbo": "2.10.13",
    "typescript": "7.0.2"
  }
}
