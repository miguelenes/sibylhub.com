{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "@sibylhub/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm build:js && pnpm build:types",
    "build:js": "tsup",
    "build:types": "tsc --project tsconfig.json --emitDeclarationOnly",
    "lint": "tsc --noEmit --project tsconfig.json",
    "format": "prettier --check src *.json *.ts",
    "format:write": "prettier --write src *.json *.ts",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@sibylhub/schemas": "workspace:*"
  },
  "devDependencies": {
    "@sibylhub/typescript-config": "workspace:*",
    "@types/node": "26.6.2",
    "@vitest/coverage-v8": "5.0.1",
    "prettier": "3.9.8",
    "tsup": "8.5.1",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
