{
  "name": "@sibylhub/typescript-config",
  "version": "1.0.0",
  "private": true,
  "files": [
    "base.json",
    "astro.json",
    "docusaurus.json",
    "schema.json"
  ],
  "scripts": {
    "build": "node -e \"console.log('TypeScript configs are JSON artifacts')\"",
    "lint": "node -e \"JSON.parse(require('fs').readFileSync('base.json')); console.log('tsconfig ok')\"",
    "typecheck": "node -e \"for (const file of ['base.json','astro.json','docusaurus.json','schema.json']) JSON.parse(require('fs').readFileSync(file)); console.log('tsconfig artifacts valid')\"",
    "test": "node -e \"console.log('tsconfig smoke test passed')\"",
    "test:cov": "pnpm test",
    "clean": "node -e \"console.log('nothing to clean')\""
  }
}
