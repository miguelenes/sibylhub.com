{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sibylhub.com/schema/skills/1.0",
  "title": "SibylHub skills document",
  "type": "object",
  "required": [
    "schemaVersion",
    "skills"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "scope",
          "declarative"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "declarative": {
            "const": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
