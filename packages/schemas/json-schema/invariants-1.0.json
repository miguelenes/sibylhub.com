{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sibylhub.com/schema/invariants/1.0",
  "title": "SibylHub invariant rules",
  "type": "object",
  "required": [
    "schemaVersion",
    "rules"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "languageId",
          "evidenceFields"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "languageId": {
            "type": "string",
            "minLength": 1
          },
          "evidenceFields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
